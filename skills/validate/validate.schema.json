{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "kill-my-idea validate.json (7-day test kit and results)",
 "type": "object",
 "required": [
  "schema_version",
  "slug",
  "generated",
  "based_on",
  "hypothesis",
  "landing",
  "interview",
  "outreach",
  "targets",
  "kill_criteria"
 ],
 "properties": {
  "schema_version": {
   "const": "1.0"
  },
  "slug": {
   "type": "string"
  },
  "generated": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "based_on": {
   "type": "object",
   "required": [
    "verdict",
    "score"
   ],
   "properties": {
    "verdict": {
     "enum": [
      "GO",
      "PIVOT",
      "NO-GO"
     ]
    },
    "score": {
     "type": "integer"
    }
   }
  },
  "hypothesis": {
   "type": "string",
   "maxLength": 200
  },
  "landing": {
   "type": "object",
   "required": [
    "name",
    "headline",
    "subhead",
    "bullets",
    "cta"
   ],
   "properties": {
    "name": {
     "type": "string",
     "maxLength": 40
    },
    "headline": {
     "type": "string",
     "maxLength": 90
    },
    "subhead": {
     "type": "string",
     "maxLength": 200
    },
    "bullets": {
     "type": "array",
     "minItems": 3,
     "maxItems": 5,
     "items": {
      "type": "string",
      "maxLength": 120
     }
    },
    "cta": {
     "type": "string",
     "maxLength": 30
    },
    "price": {
     "type": [
      "object",
      "null"
     ],
     "properties": {
      "amount": {
       "type": "number",
       "minimum": 0
      },
      "currency": {
       "type": "string",
       "maxLength": 5
      },
      "period": {
       "type": "string",
       "maxLength": 20
      }
     }
    },
    "proof": {
     "type": [
      "object",
      "null"
     ],
     "properties": {
      "text": {
       "type": "string",
       "maxLength": 200
      },
      "source": {
       "type": "string",
       "pattern": "^https?://"
      }
     }
    },
    "form_url": {
     "type": "string",
     "pattern": "^(https://\\S+)?$"
    }
   }
  },
  "interview": {
   "type": "object",
   "required": [
    "who",
    "questions"
   ],
   "properties": {
    "who": {
     "type": "string",
     "maxLength": 160
    },
    "questions": {
     "type": "array",
     "minItems": 5,
     "maxItems": 12,
     "items": {
      "type": "string",
      "maxLength": 200
     }
    },
    "red_flags": {
     "type": "array",
     "items": {
      "type": "string",
      "maxLength": 160
     }
    }
   }
  },
  "outreach": {
   "type": "array",
   "minItems": 1,
   "maxItems": 6,
   "items": {
    "type": "object",
    "required": [
     "channel",
     "where",
     "links_allowed",
     "text"
    ],
    "properties": {
     "channel": {
      "type": "string",
      "maxLength": 40
     },
     "where": {
      "type": "string",
      "maxLength": 80
     },
     "links_allowed": {
      "type": "boolean"
     },
     "text": {
      "type": "string",
      "maxLength": 700
     }
    }
   }
  },
  "targets": {
   "type": "array",
   "minItems": 2,
   "maxItems": 6,
   "items": {
    "type": "object",
    "required": [
     "id",
     "metric",
     "label",
     "goal",
     "by",
     "moves"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^T\\d{1,2}$"
     },
     "metric": {
      "enum": [
       "signups",
       "replies",
       "interviews_pain",
       "presales",
       "visits",
       "conversion",
       "other"
      ]
     },
     "label": {
      "type": "string",
      "maxLength": 120
     },
     "goal": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "out_of": {
      "type": [
       "number",
       "null"
      ]
     },
     "by": {
      "type": "string",
      "maxLength": 20
     },
     "moves": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "description": "one of the 21 sub-score keys"
      }
     }
    }
   }
  },
  "kill_criteria": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "maxLength": 200
   }
  },
  "results": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "date",
    "entries",
    "rescored"
   ],
   "properties": {
    "date": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "entries": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "target",
       "actual",
       "evidence"
      ],
      "properties": {
       "target": {
        "type": "string"
       },
       "actual": {
        "type": "number",
        "minimum": 0
       },
       "out_of": {
        "type": [
         "number",
         "null"
        ]
       },
       "evidence": {
        "type": "string",
        "maxLength": 200
       }
      }
     }
    },
    "moves": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "sub",
       "from",
       "to",
       "target",
       "why"
      ],
      "properties": {
       "sub": {
        "type": "string",
        "description": "one of the 21 sub-score keys"
       },
       "from": {
        "type": "number"
       },
       "to": {
        "type": "number"
       },
       "target": {
        "type": "string"
       },
       "why": {
        "type": "string",
        "maxLength": 200
       }
      }
     }
    },
    "clears": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "kill_shot",
       "target"
      ],
      "properties": {
       "kill_shot": {
        "type": "string"
       },
       "target": {
        "type": "string"
       }
      }
     }
    },
    "rescored": {
     "type": "object",
     "description": "verdict.json format: criteria_detail, kill_shots, rules_applied, metrics, score, score_raw, verdict"
    }
   }
  }
 }
}