{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RemiPelloux/kill-my-idea/skills/fix/fix.schema.json",
  "title": "kill-my-idea fix (path to GO)",
  "description": "Content of ideas/<folder>/fix.json, written by the fix skill. scripts/fix-kit.py checks it against verdict.json (every changed sub-score needs a lever, the fixed score recomputes with check-idea.py's rules, the price position matches the competitors) and adds narrative.fix to report-data.json. The fixed score is a projection; verdict.json is never changed.",
  "type": "object",
  "required": [
    "schema_version",
    "slug",
    "generated",
    "based_on",
    "summary",
    "pricing",
    "features",
    "levers",
    "fixed",
    "reachable",
    "plan",
    "kill_criteria"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "slug": {
      "type": "string"
    },
    "generated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "based_on": {
      "type": "object",
      "required": [
        "verdict",
        "score"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "GO",
            "PIVOT",
            "NO-GO"
          ]
        },
        "score": {
          "type": "integer"
        }
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 200
    },
    "pricing": {
      "type": "object",
      "required": [
        "competitors",
        "recommended"
      ],
      "properties": {
        "current": {
          "type": "object",
          "required": [
            "amount",
            "period"
          ],
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "maxLength": 3
            },
            "period": {
              "type": "string",
              "maxLength": 20
            }
          }
        },
        "competitors": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "name",
              "amount",
              "period",
              "source"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 60
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "period": {
                "type": "string",
                "maxLength": 20
              },
              "source": {
                "type": "string",
                "pattern": "^https?://"
              },
              "as_of": {
                "type": "string"
              }
            }
          }
        },
        "recommended": {
          "type": "object",
          "required": [
            "amount",
            "period",
            "position",
            "why"
          ],
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "period": {
              "type": "string",
              "maxLength": 20
            },
            "position": {
              "enum": [
                "undercut",
                "match",
                "premium"
              ]
            },
            "why": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "required": [
        "must",
        "differentiator"
      ],
      "properties": {
        "must": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "feature",
              "why",
              "source"
            ],
            "properties": {
              "feature": {
                "type": "string",
                "maxLength": 100
              },
              "why": {
                "type": "string",
                "maxLength": 200
              },
              "source": {
                "type": "string",
                "pattern": "^https?://"
              }
            }
          }
        },
        "cut": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "feature",
              "why"
            ],
            "properties": {
              "feature": {
                "type": "string",
                "maxLength": 100
              },
              "why": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        },
        "differentiator": {
          "type": "object",
          "required": [
            "feature",
            "why",
            "source"
          ],
          "properties": {
            "feature": {
              "type": "string",
              "maxLength": 100
            },
            "why": {
              "type": "string",
              "maxLength": 200
            },
            "source": {
              "type": "string",
              "pattern": "^https?://"
            }
          }
        }
      }
    },
    "levers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "change",
          "evidence",
          "source",
          "difficulty",
          "effort",
          "cost",
          "prerequisites"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^L\\d{1,2}$"
          },
          "kind": {
            "enum": [
              "price",
              "features",
              "customer",
              "channel",
              "model",
              "country",
              "cost",
              "other"
            ]
          },
          "change": {
            "type": "string",
            "maxLength": 200
          },
          "evidence": {
            "type": "string",
            "maxLength": 300
          },
          "source": {
            "type": "string",
            "pattern": "^https?://"
          },
          "difficulty": {
            "enum": [
              "doable",
              "hard",
              "very-hard"
            ]
          },
          "effort": {
            "type": "string",
            "maxLength": 60
          },
          "cost": {
            "type": "string",
            "maxLength": 80
          },
          "moves": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sub",
                "from",
                "to",
                "why"
              ],
              "properties": {
                "sub": {
                  "enum": [
                    "gross_margin",
                    "ltv_cac",
                    "pricing_power",
                    "build_effort",
                    "skills_match",
                    "capital_needed",
                    "time_to_mvp",
                    "sales_cycle",
                    "channel_readiness",
                    "search_demand",
                    "trend",
                    "willingness_to_pay",
                    "free_alternatives",
                    "competitor_density",
                    "differentiation",
                    "legal_regulatory",
                    "platform_dependency",
                    "market_risk",
                    "skills",
                    "assets",
                    "interest"
                  ]
                },
                "from": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5
                },
                "to": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5
                },
                "why": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            }
          },
          "clears": {
            "type": "array",
            "items": {
              "enum": [
                "free_alternative",
                "strong_competitor",
                "graveyard",
                "no_distribution",
                "costs_eat_margin",
                "weak_demand",
                "legal_platform_risk",
                "saturated_wave"
              ]
            }
          },
          "prerequisites": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "what",
                "kind",
                "have"
              ],
              "properties": {
                "what": {
                  "type": "string",
                  "maxLength": 160
                },
                "kind": {
                  "enum": [
                    "skill",
                    "money",
                    "time",
                    "partner",
                    "legal",
                    "data",
                    "audience"
                  ]
                },
                "cost": {
                  "type": "string",
                  "maxLength": 80
                },
                "have": {
                  "enum": [
                    "yes",
                    "no",
                    "unknown"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "fixed": {
      "type": "object",
      "required": [
        "criteria_detail",
        "kill_shots",
        "rules_applied",
        "score",
        "score_raw",
        "verdict"
      ],
      "properties": {
        "criteria_detail": {
          "type": "object",
          "description": "The 21 sub-scores in verdict.json format"
        },
        "kill_shots": {
          "type": "object"
        },
        "rules_applied": {
          "type": "array"
        },
        "metrics": {
          "type": "object"
        },
        "score": {
          "type": "integer"
        },
        "score_raw": {
          "type": "number"
        },
        "verdict": {
          "enum": [
            "GO",
            "PIVOT",
            "NO-GO"
          ]
        }
      }
    },
    "reachable": {
      "type": "boolean"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "plan": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "when",
          "step",
          "verify"
        ],
        "properties": {
          "when": {
            "type": "string",
            "maxLength": 30
          },
          "step": {
            "type": "string",
            "maxLength": 200
          },
          "verify": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "kill_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    }
  }
}
