{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RemiPelloux/kill-my-idea/skills/build/build-plan.schema.json",
  "title": "kill-my-idea build plan",
  "description": "Content of ideas/<folder>/build/plan.json, written by the build skill. scripts/build-kit.py checks it against verdict.json (it enforces more than this schema: counts, contrast, lifetime profit vs target CPA) and renders the starter kit from it. Plain text only in every string.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slug",
    "generated",
    "based_on",
    "product",
    "stack",
    "env",
    "structure",
    "personas",
    "stories",
    "sprints",
    "dod",
    "business_plan",
    "brand",
    "motion",
    "ads",
    "ad_test"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "slug": {
      "type": "string"
    },
    "generated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "based_on": {
      "type": "object",
      "required": [
        "verdict",
        "score",
        "path",
        "change"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "GO",
            "PIVOT",
            "NO-GO"
          ]
        },
        "score": {
          "type": "integer"
        },
        "path": {
          "type": "string",
          "pattern": "^(original|rescue-\\d|fix)$"
        },
        "change": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "product": {
      "type": "object",
      "required": [
        "name",
        "one_liner",
        "customer",
        "problem",
        "key_metric"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 60
        },
        "one_liner": {
          "type": "string",
          "maxLength": 160
        },
        "customer": {
          "type": "string",
          "maxLength": 300
        },
        "problem": {
          "type": "string",
          "maxLength": 300
        },
        "key_metric": {
          "type": "object",
          "required": [
            "name",
            "target",
            "deadline"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 80
            },
            "target": {
              "type": "string",
              "maxLength": 80
            },
            "deadline": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      }
    },
    "stack": {
      "type": "object",
      "required": [
        "choice",
        "why",
        "components",
        "alternatives"
      ],
      "additionalProperties": false,
      "properties": {
        "choice": {
          "type": "string",
          "maxLength": 120
        },
        "why": {
          "type": "string",
          "maxLength": 500
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "tool",
              "cost_month"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 60
              },
              "tool": {
                "type": "string",
                "maxLength": 80
              },
              "cost_month": {
                "type": "number",
                "minimum": 0
              },
              "source": {
                "type": "string",
                "pattern": "^https?://"
              }
            }
          }
        },
        "alternatives": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "name",
              "why_not"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 80
              },
              "why_not": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "purpose",
          "required"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "purpose": {
            "type": "string",
            "maxLength": 160
          },
          "required": {
            "type": "boolean"
          },
          "where": {
            "type": "string",
            "pattern": "^https?://"
          }
        }
      }
    },
    "structure": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "path",
          "purpose"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "purpose": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "name",
          "role",
          "pain"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "role": {
            "type": "string",
            "maxLength": 160
          },
          "pain": {
            "type": "string",
            "maxLength": 300
          },
          "quote": {
            "type": "string",
            "maxLength": 300
          },
          "quote_url": {
            "type": "string",
            "pattern": "^https?://"
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "persona",
          "want",
          "so_that",
          "priority",
          "points",
          "sprint",
          "acceptance"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^US-\\d{2,3}$"
          },
          "persona": {
            "type": "string"
          },
          "want": {
            "type": "string",
            "maxLength": 200
          },
          "so_that": {
            "type": "string",
            "maxLength": 200
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "could"
            ]
          },
          "points": {
            "enum": [
              1,
              2,
              3,
              5,
              8,
              13
            ]
          },
          "sprint": {
            "type": "integer",
            "minimum": 0
          },
          "acceptance": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      }
    },
    "sprints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "number",
          "name",
          "goal",
          "weeks",
          "exit"
        ],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "goal": {
            "type": "string",
            "maxLength": 300
          },
          "weeks": {
            "enum": [
              1,
              2
            ]
          },
          "exit": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "dod": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "business_plan": {
      "type": "object",
      "required": [
        "currency",
        "inputs",
        "scenarios"
      ],
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "maxLength": 3
        },
        "inputs": {
          "type": "object",
          "required": [
            "revenue_per_customer_month",
            "variable_cost_per_customer_month",
            "cac",
            "churn_monthly_pct",
            "fixed_costs_month",
            "start_cash"
          ],
          "additionalProperties": false,
          "properties": {
            "revenue_per_customer_month": {
              "type": "object",
              "required": [
                "value",
                "basis"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "basis": {
                  "enum": [
                    "verdict",
                    "sourced",
                    "estimate"
                  ]
                },
                "source": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "reasoning": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            },
            "variable_cost_per_customer_month": {
              "type": "object",
              "required": [
                "value",
                "basis"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "basis": {
                  "enum": [
                    "verdict",
                    "sourced",
                    "estimate"
                  ]
                },
                "source": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "reasoning": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            },
            "cac": {
              "type": "object",
              "required": [
                "value",
                "basis"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "basis": {
                  "enum": [
                    "verdict",
                    "sourced",
                    "estimate"
                  ]
                },
                "source": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "reasoning": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            },
            "churn_monthly_pct": {
              "type": "object",
              "required": [
                "value",
                "basis"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "basis": {
                  "enum": [
                    "verdict",
                    "sourced",
                    "estimate"
                  ]
                },
                "source": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "reasoning": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            },
            "fixed_costs_month": {
              "type": "object",
              "required": [
                "value",
                "basis"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "basis": {
                  "enum": [
                    "verdict",
                    "sourced",
                    "estimate"
                  ]
                },
                "source": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "reasoning": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            },
            "start_cash": {
              "type": "object",
              "required": [
                "value",
                "basis"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "basis": {
                  "enum": [
                    "verdict",
                    "sourced",
                    "estimate"
                  ]
                },
                "source": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "reasoning": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            }
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "name",
              "new_customers",
              "note"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "enum": [
                  "Pessimistic",
                  "Base",
                  "Optimistic"
                ]
              },
              "new_customers": {
                "type": "array",
                "minItems": 12,
                "maxItems": 12,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "note": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "month",
              "what"
            ],
            "additionalProperties": false,
            "properties": {
              "month": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "what": {
                "type": "string",
                "maxLength": 160
              }
            }
          }
        }
      }
    },
    "brand": {
      "type": "object",
      "required": [
        "name",
        "tagline",
        "tone",
        "colors"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 40
        },
        "tagline": {
          "type": "string",
          "maxLength": 80
        },
        "tone": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 30
          }
        },
        "colors": {
          "type": "object",
          "required": [
            "bg",
            "fg",
            "accent",
            "muted"
          ],
          "additionalProperties": false,
          "properties": {
            "bg": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "fg": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "muted": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "required": [
        "format",
        "fps",
        "music",
        "scenes"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "1080x1920",
            "1080x1080",
            "1920x1080",
            "1200x628"
          ]
        },
        "fps": {
          "enum": [
            24,
            25,
            30,
            60
          ]
        },
        "music": {
          "type": "string",
          "maxLength": 200
        },
        "scenes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "duration_s",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "hook",
                  "problem",
                  "stat",
                  "product",
                  "proof",
                  "cta"
                ]
              },
              "duration_s": {
                "type": "number",
                "minimum": 1.5,
                "maximum": 8
              },
              "text": {
                "type": "string",
                "maxLength": 60
              },
              "sub": {
                "type": "string",
                "maxLength": 90
              },
              "voiceover": {
                "type": "string",
                "maxLength": 200
              },
              "stat": {
                "type": "number",
                "minimum": 0
              },
              "stat_suffix": {
                "type": "string",
                "maxLength": 8
              },
              "source": {
                "type": "string",
                "pattern": "^https?://"
              }
            }
          }
        }
      }
    },
    "ads": {
      "type": "array",
      "minItems": 3,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": [
          "id",
          "channel",
          "persona",
          "angle",
          "hook",
          "headline",
          "primary_text",
          "cta",
          "format",
          "visual",
          "proof",
          "proof_source",
          "target_cpa"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AD-\\d{1,2}$"
          },
          "channel": {
            "enum": [
              "meta",
              "tiktok",
              "instagram",
              "youtube",
              "google",
              "linkedin",
              "reddit",
              "x",
              "pinterest",
              "email",
              "other"
            ]
          },
          "persona": {
            "type": "string"
          },
          "angle": {
            "type": "string",
            "maxLength": 80
          },
          "hook": {
            "type": "string",
            "maxLength": 70
          },
          "headline": {
            "type": "string",
            "maxLength": 60
          },
          "primary_text": {
            "type": "string",
            "maxLength": 300
          },
          "cta": {
            "type": "string",
            "maxLength": 24
          },
          "format": {
            "enum": [
              "1080x1920",
              "1080x1080",
              "1920x1080",
              "1200x628"
            ]
          },
          "visual": {
            "type": "string",
            "maxLength": 400
          },
          "proof": {
            "type": "string",
            "maxLength": 160
          },
          "proof_source": {
            "type": "string",
            "pattern": "^https?://"
          },
          "target_cpa": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "ad_test": {
      "type": "object",
      "required": [
        "budget",
        "days",
        "kill_rule"
      ],
      "additionalProperties": false,
      "properties": {
        "budget": {
          "type": "number",
          "minimum": 0
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "kill_rule": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
