{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RemiPelloux/kill-my-idea/skills/kill/verdict.schema.json",
  "title": "kill-my-idea verdict",
  "description": "Machine-readable verdict and metrics. Read by /kill-my-idea:compare and /kill-my-idea:deepdive. Each metric carries its own source or is marked estimate.",
  "type": "object",
  "required": [
    "slug",
    "evaluated",
    "verdict",
    "score",
    "criteria",
    "metrics",
    "kill_shots"
  ],
  "$defs": {
    "metric": {
      "type": "object",
      "required": [
        "value",
        "basis"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ],
          "description": "null or \"unknown\" when not found"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "enum": [
            "sourced",
            "estimate",
            "unknown"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "description": "URL when basis is sourced"
        },
        "reasoning": {
          "type": [
            "string",
            "null"
          ],
          "description": "Required when basis is estimate"
        }
      }
    }
  },
  "properties": {
    "slug": {
      "type": "string"
    },
    "evaluated": {
      "type": "string",
      "format": "date"
    },
    "mode": {
      "enum": [
        "kill",
        "deepdive",
        "roast"
      ]
    },
    "verdict": {
      "enum": [
        "GO",
        "PIVOT",
        "NO-GO"
      ]
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "criteria": {
      "type": "object",
      "required": [
        "profit",
        "feasibility",
        "time_to_first_revenue",
        "demand",
        "competition",
        "risk",
        "fit"
      ],
      "additionalProperties": {
        "type": "number",
        "minimum": 1,
        "maximum": 5,
        "multipleOf": 0.5
      },
      "description": "Each criterion = average of its 3 sub-scores in criteria_detail, rounded to 0.5"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "tam": {
          "$ref": "#/$defs/metric"
        },
        "sam": {
          "$ref": "#/$defs/metric"
        },
        "som": {
          "$ref": "#/$defs/metric"
        },
        "competitors_found": {
          "$ref": "#/$defs/metric"
        },
        "competitor_price_range": {
          "$ref": "#/$defs/metric"
        },
        "demand_trend": {
          "$ref": "#/$defs/metric"
        },
        "price": {
          "$ref": "#/$defs/metric"
        },
        "gross_margin_pct": {
          "$ref": "#/$defs/metric"
        },
        "cac": {
          "$ref": "#/$defs/metric"
        },
        "ltv": {
          "$ref": "#/$defs/metric"
        },
        "ltv_cac": {
          "$ref": "#/$defs/metric"
        },
        "payback_months": {
          "$ref": "#/$defs/metric"
        },
        "break_even_customers_per_month": {
          "$ref": "#/$defs/metric"
        },
        "time_to_first_revenue_weeks": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "by_country": {
      "type": "object",
      "description": "Optional: same metrics keyed by ISO country code, plus a recommended launch country",
      "additionalProperties": {
        "type": "object"
      }
    },
    "launch_country": {
      "type": [
        "string",
        "null"
      ]
    },
    "kill_shots": {
      "type": "object",
      "properties": {
        "free_alternative": {
          "type": "boolean"
        },
        "strong_competitor": {
          "type": "boolean"
        },
        "graveyard": {
          "type": "boolean"
        },
        "no_distribution": {
          "type": "boolean"
        },
        "costs_eat_margin": {
          "type": "boolean"
        },
        "weak_demand": {
          "type": "boolean"
        },
        "legal_platform_risk": {
          "type": "boolean"
        }
      }
    },
    "cheapest_test": {
      "type": [
        "string",
        "null"
      ]
    },
    "kill_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rescue": {
      "type": "array",
      "description": "Ways to make the idea better (see report-data.schema.json narrative.rescue). Most promising first.",
      "items": {
        "type": "object",
        "required": [
          "change",
          "score_after",
          "difficulty"
        ],
        "properties": {
          "change": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "score_after": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "difficulty": {
            "enum": [
              "doable",
              "hard",
              "very-hard"
            ]
          },
          "effort": {
            "type": "string"
          },
          "cost": {
            "type": "string"
          },
          "requires": {
            "type": "string"
          }
        }
      }
    },
    "criteria_detail": {
      "type": "object",
      "description": "21 sub-scores: 3 per criterion",
      "properties": {
        "profit": {
          "type": "object",
          "required": [
            "gross_margin",
            "ltv_cac",
            "pricing_power"
          ],
          "properties": {
            "gross_margin": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "ltv_cac": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "pricing_power": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "feasibility": {
          "type": "object",
          "required": [
            "build_effort",
            "skills_match",
            "capital_needed"
          ],
          "properties": {
            "build_effort": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "skills_match": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "capital_needed": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "time_to_first_revenue": {
          "type": "object",
          "required": [
            "time_to_mvp",
            "sales_cycle",
            "channel_readiness"
          ],
          "properties": {
            "time_to_mvp": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "sales_cycle": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "channel_readiness": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "demand": {
          "type": "object",
          "required": [
            "search_demand",
            "trend",
            "willingness_to_pay"
          ],
          "properties": {
            "search_demand": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "trend": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "willingness_to_pay": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "competition": {
          "type": "object",
          "required": [
            "free_alternatives",
            "competitor_density",
            "differentiation"
          ],
          "properties": {
            "free_alternatives": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "competitor_density": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "differentiation": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "risk": {
          "type": "object",
          "required": [
            "legal_regulatory",
            "platform_dependency",
            "market_risk"
          ],
          "properties": {
            "legal_regulatory": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "platform_dependency": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "market_risk": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
