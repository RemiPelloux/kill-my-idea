                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "fit": {
          "type": "object",
          "required": [
            "skills",
            "assets",
            "interest"
          ],
          "properties": {
            "skills": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "assets": {
              "type": "object",
              "required": [
                "score",
                "note"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5,
                  "multipleOf": 0.5
                },
                "note": {
                  "type": "string",
                  "maxLength": 160
                },
