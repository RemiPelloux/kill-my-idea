{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "kill-my-idea nuke.json (a full run)",
 "type": "object",
 "required": [
  "schema_version",
  "slug",
  "generated",
  "kill_score",
  "steps"
 ],
 "properties": {
  "schema_version": {
   "const": "1.0"
  },
  "slug": {
   "type": "string"
  },
  "generated": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "kill_score": {
   "type": "integer",
   "minimum": 0,
   "maximum": 100
  },
  "steps": {
   "type": "array",
   "minItems": 6,
   "maxItems": 6,
   "items": {
    "type": "object",
    "required": [
     "step",
     "status"
    ],
    "properties": {
     "step": {
      "enum": [
       "kill",
       "deepdive",
       "fix",
       "validate",
       "build",
       "share"
      ]
     },
     "status": {
      "enum": [
       "done",
       "skipped",
       "stopped"
      ]
     },
     "why": {
      "type": "string",
      "maxLength": 200
     }
    }
   }
  },
  "continued_past_stop": {
   "type": [
    "boolean",
    "null"
   ]
  },
  "continued_why": {
   "type": "string",
   "maxLength": 200
  },
  "minutes": {
   "type": [
    "number",
    "null"
   ],
   "minimum": 0,
   "maximum": 600
  },
  "cost_usd": {
   "type": [
    "number",
    "null"
   ],
   "minimum": 0,
   "maximum": 100
  }
 }
}