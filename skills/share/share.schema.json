{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "kill-my-idea share.json (verdict card and post drafts)",
 "type": "object",
 "required": [
  "schema_version",
  "slug",
  "generated",
  "card",
  "posts"
 ],
 "properties": {
  "schema_version": {
   "const": "1.0"
  },
  "slug": {
   "type": "string"
  },
  "generated": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "card": {
   "type": "object",
   "required": [
    "headline",
    "reasons"
   ],
   "properties": {
    "headline": {
     "type": "string",
     "maxLength": 60
    },
    "reasons": {
     "type": "array",
     "minItems": 2,
     "maxItems": 3,
     "items": {
      "type": "string",
      "maxLength": 90
     }
    },
    "after": {
     "type": "string",
     "maxLength": 60
    }
   }
  },
  "posts": {
   "type": "array",
   "minItems": 1,
   "maxItems": 6,
   "items": {
    "type": "object",
    "required": [
     "platform",
     "place",
     "links_allowed",
     "body"
    ],
    "properties": {
     "platform": {
      "enum": [
       "reddit",
       "x",
       "linkedin",
       "hn",
       "other"
      ]
     },
     "place": {
      "type": "string",
      "maxLength": 60
     },
     "links_allowed": {
      "type": "boolean"
     },
     "title": {
      "type": "string",
      "maxLength": 300
     },
     "body": {
      "type": "string",
      "maxLength": 10000
     },
     "link": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^https://\\S+$"
     }
    }
   }
  }
 }
}