# LunchLine: copy to .env and fill in. Never commit .env.

# Authenticate Retell API calls and verify webhooks (required)
# Get it: https://www.retellai.com/pricing?utm_category=ai
RETELL_API_KEY=

# Open Dental API developer key (required)
# Get it: https://www.opendental.com/site/apipermissions.html
OPEN_DENTAL_DEVELOPER_KEY=

# Per-clinic customer key (one clinic in the pilot) (required)
OPEN_DENTAL_CUSTOMER_KEY=

# HTTP port for the webhook server (optional)
PORT=

# Monthly billing and cancel link (optional)
STRIPE_SECRET_KEY=
